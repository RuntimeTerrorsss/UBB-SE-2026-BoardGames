@model IEnumerable<GameDTO>

@{
    ViewData["Title"] = "Games";
    bool showOwner = User.IsInRole("Administrator");
}

<div class="page-header">
    <h1 class="page-title">Games</h1>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Create Game</a>
    </div>
</div>

@if (TempData["DeleteError"] is string deleteError)
{
    <div class="alert alert-danger" role="alert">@deleteError</div>
}

@if (Model is null || !Model.Any())
{
    <div class="empty-state">
        <p>No games available.</p>
    </div>
}
else
{
    <div class="games-index-list">
@foreach (var item in Model)
{
        <div class="@(item.IsActive ? "games-index-card" : "games-index-card games-index-card-inactive")">
            <a class="games-index-primary" asp-action="Details" asp-route-id="@item.Id">
                <div class="games-index-image-wrap">
                    <img class="games-index-image"
                         src="@GameImageHelper.GetDisplaySource(item)"
                         alt="@item.Name"
                         loading="lazy"
                         onerror="this.onerror=null;this.src='@GameImageHelper.PlaceholderImageSource'" />
                </div>

                <div class="games-index-body">
                    <div class="games-index-title-row">
                        <h2 class="games-index-title">@item.Name</h2>
                        <div class="games-index-status">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success games-index-status-badge">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary games-index-status-badge">Inactive</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p class="games-index-description">@item.Description</p>
                    }

                    <div class="games-index-meta">
                        <span>Price: @item.Price</span>
                        <span>Players: @item.MinimumPlayerNumber - @item.MaximumPlayerNumber</span>
                    </div>

                    @if (showOwner && !string.IsNullOrWhiteSpace(item.Owner?.DisplayName))
                    {
                        <div class="games-index-owner">Owner: @item.Owner.DisplayName</div>
                    }
                </div>
            </a>

            <div class="games-index-actions">
                <a class="btn btn-warning btn-sm games-index-action-button" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-danger btn-sm games-index-action-button" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </div>
        </div>
}
    </div>
}
